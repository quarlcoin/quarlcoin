# /etc/conf.d/quarld: config file for /etc/init.d/quarld

# Config file location
#QUARLD_CONFIGFILE="/etc/quarlcoin/quarlcoin.conf"

# What directory to write pidfile to?  (created and owned by $QUARLD_USER)
#QUARLD_PIDDIR="/var/run/quarld"

# What filename to give the pidfile
#QUARLD_PIDFILE="${QUARLD_PIDDIR}/quarld.pid"

# Where to write quarld data (be mindful that the blockchain is large)
#QUARLD_DATADIR="/var/lib/quarld"

# User and group to own quarld process
#QUARLD_USER="quarlcoin"
#QUARLD_GROUP="quarlcoin"

# Path to quarld executable
#QUARLD_BIN="/usr/bin/quarld"

# Nice value to run quarld under
#QUARLD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#QUARLD_OPTS=""

# The timeout in seconds OpenRC will wait for quarld to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
QUARLD_SIGTERM_TIMEOUT=600
